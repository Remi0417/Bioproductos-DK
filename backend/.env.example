DJANGO_SECRET_KEY='genera-una-con-get_random_secret_key'
DJANGO_DEBUG=True

DB_NAME=bioproductosdk
DB_USER=bioproductos
DB_PASSWORD='tu-contraseña'
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Shopify (Storefront API). Los tokens se piden al equipo por un canal privado;
# nunca se suben a GitHub. Sin estas variables, /productos usa la simulación local.
SHOPIFY_STORE_DOMAIN=bioproductos-dk-prototipo.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=pide-el-token-al-equipo
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=pide-el-token-al-equipo
SHOPIFY_API_VERSION=2026-10
