# Entorno exclusivamente local. Copiar con npm run setup:env.
DK_DEMO_MODE=true
DATABASE_URL=
# Completar con PostgreSQL local y base bioproductos_dk_demo. No usar un superusuario.
STORE_CORS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:5173
# setup:env genera valores aleatorios privados; no completar este ejemplo con secretos.
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_DISABLE_TELEMETRY=true
