{
  "name": "bioproductos-dk-demo",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace=@dtc/backend",
    "dev:storefront": "npm run dev --workspace=@dtc/storefront",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test tests/*.test.mjs",
    "format:check": "prettier --check apps scripts tests data package.json playwright.config.ts",
    "format": "prettier --write apps scripts tests data package.json playwright.config.ts",
    "db:migrate": "node scripts/run-medusa.mjs db:migrate",
    "db:seed": "node scripts/run-medusa.mjs exec ./src/scripts/seed-dk-demo.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "test:integration": "npm run test:integration:http --workspace=@dtc/backend",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@medusajs/eslint-plugin": "2.21.2",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turbo": "^2.0.14",
    "@typescript-eslint/typescript-estree": "^8.71.2"
  },
  "workspaces": [
    "apps/backend",
    "apps/storefront"
  ],
  "overrides": {
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "tsconfig-paths": "^4.2.0",
    "next": {
      "react": "19.0.5",
      "react-dom": "19.0.5"
    }
  }
}
